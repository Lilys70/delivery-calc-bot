# Скопируйте этот файл в .env и вставьте реальный токен.
# Токен выдаёт @BotFather в Telegram: /newbot -> имя бота -> токен.
# Файл .env в репозиторий не попадает (он в .gitignore).
BOT_TOKEN=ваш_токен_здесь

# Входящий вебхук Битрикс24 для передачи заявок (crm.py).
# Пример: https://your-portal.bitrix24.ru/rest/1/xxxxxxxxxxxxxxxx/
# Старое имя переменной BITRIX_WEBHOOK тоже читается как запасное.
BITRIX_WEBHOOK_URL=

# Прокси (опционально). Раскомментируйте и заполните, если api.telegram.org
# не доступен напрямую.
# Пример: http://user:pass@host:port или socks5://host:port
PROXY_URL=

# Telegram-id оператора: сюда бот присылает детали новой заявки после
# успешного создания сделки в Битрикс24. Свой id можно узнать у бота
# @userinfobot. Переменная не задана — уведомление не отправляется.
MANAGER_CHAT_ID=
